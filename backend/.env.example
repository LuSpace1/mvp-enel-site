# Django
DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Rol tecnico propuesto para administrar el contenido del portal.
# Debe confirmarse con Enel/CompAC antes de produccion.
PORTAL_ADMIN_ROLE=Portal_Admin

# Lista opcional de grupos que el conector SCIM puede crear (separados por coma).
# Vacia = catalogo dinamico. El rol de administracion siempre esta permitido.
SCIM_ALLOWED_GROUPS=

# Limites de peticiones (formato DRF: "N/minuto")
LOGIN_THROTTLE_RATE=10/min
SCIM_THROTTLE_RATE=600/min
OAUTH_TOKEN_THROTTLE_RATE=30/min

# Las credenciales del cliente OAuth2 de CompAC NO se guardan en este archivo.
# Se crean en el Admin de Django (aplicacion con grant client_credentials y
# scope "scim") y el secreto se entrega por el canal seguro del entorno.
