# Django
DEBUG=True
SECRET_KEY=django-insecure-mvp-enel-site-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. En produccion cambiar DB_PASSWORD y no versionar credenciales.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=portal_enel
DB_USER=postgres
DB_PASSWORD=cambia-esta-contraseña
DB_HOST=127.0.0.1
DB_PORT=5432

# Roles del CMS (nombres propuestos, pendientes de CompAC).
PORTAL_ADMIN_ROLE=Portal_Admin
CMS_EDITOR_ROLE=CMS_Editor
CMS_PUBLISHER_ROLE=CMS_Publisher

# Limites de imagenes del CMS (binarios en la base durante el MVP).
CMS_IMAGE_MAX_BYTES=5242880
CMS_IMAGE_MAX_DIMENSION=2560

# Lista opcional de grupos que el conector SCIM puede crear (separados por coma).
# Vacia = catalogo dinamico. Los roles tecnicos del portal siempre estan permitidos.
SCIM_ALLOWED_GROUPS=

# Limites de peticiones (formato DRF: "N/minuto")
LOGIN_THROTTLE_RATE=10/min
SCIM_THROTTLE_RATE=600/min
OAUTH_TOKEN_THROTTLE_RATE=30/min

# Las credenciales del cliente OAuth2 de CompAC NO se guardan en este archivo.
